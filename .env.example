# ============================================================================
#  Copy this file to ".env"  (cp .env.example .env)  and fill in real values.
#  docker-compose.yml reads ".env" automatically. NEVER commit your real .env.
# ============================================================================

# ---- PostgreSQL (the app's database; created automatically by the container) ----
POSTGRES_DB=ping
POSTGRES_USER=pinguser
POSTGRES_PASSWORD=change-this-to-a-strong-db-password

# ---- Mail / Gmail SMTP --------------------------------------------------------
# >>> PASTE YOUR REAL GMAIL VALUES HERE <<<
# MAIL_USERNAME = the Gmail address that sends the alert emails
# MAIL_PASSWORD = the 16-character Google "App Password" (NOT your normal Gmail password)
#   How to get it: Google Account -> Security -> 2-Step Verification (must be ON)
#   -> App passwords -> create one for "Mail". Paste the 16 chars (spaces are fine).
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=paste-your-16-char-app-password-here

# ---- Auth ---------------------------------------------------------------------
# Long random string, at least 32 characters. Generate e.g.:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# ---- Observability ------------------------------------------------------------
# Application log level for com.heartbeat.ping (TRACE/DEBUG/INFO/WARN/ERROR). Default INFO.
# Can also be changed at runtime via POST /actuator/loggers/com.heartbeat.ping.
LOG_LEVEL=INFO
# Grafana admin password (used only with the "observability" compose profile). Default: admin.
GRAFANA_ADMIN_PASSWORD=admin
# Host port for Grafana. Override if something else (e.g. a local dev server) already uses 3000.
GRAFANA_PORT=3000
